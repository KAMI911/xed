FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    debhelper \
    dh-python \
    gobject-introspection \
    gtk-doc-tools \
    intltool \
    libgirepository1.0-dev \
    libglib2.0-dev \
    libgspell-1-dev \
    libgtk-3-dev \
    libgtksourceview-4-dev \
    libpeas-dev \
    libxapp-dev \
    libx11-dev \
    libxml2-dev \
    meson \
    ninja-build \
    python3 \
    python3-gi-dev \
    yelp-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# .deb build
RUN dpkg-buildpackage -us -uc -b -j$(nproc)

# A kész csomagokat /output alá gyűjtjük
RUN mkdir -p /output && mv /src/../xed*.deb /output/ 2>/dev/null || true; \
    mv /src/../xed*.changes /output/ 2>/dev/null || true

CMD ["ls", "-lh", "/output"]
